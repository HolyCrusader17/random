{
  "sheet": "ranks",
  "about": "The ULTRAKILL style ranks, lowest first. Style points decay every second; the rank is the highest row whose threshold the meter has reached. Names are ULTRAKILL's own rank names. power_* columns are the Power-mode buffs at that rank.",
  "columns": {
    "id": {
      "type": "string",
      "desc": "Row id"
    },
    "order": {
      "type": "int",
      "desc": "0 = lowest"
    },
    "letter": {
      "type": "string",
      "desc": "Big letter on the HUD"
    },
    "name": {
      "type": "string",
      "desc": "ULTRAKILL rank name shown under the letter"
    },
    "threshold": {
      "type": "int",
      "desc": "Style points needed to reach this rank"
    },
    "decay_per_s": {
      "type": "number",
      "desc": "Style points lost per second while at this rank"
    },
    "color": {
      "type": "string",
      "desc": "HUD colour, #RRGGBB"
    },
    "up_sound": {
      "type": "ref:audio",
      "desc": "ULTRAKILL clip played on reaching this rank"
    },
    "music_tier": {
      "type": "ref:music_tiers",
      "desc": "How intense the ULTRAKILL music is at this rank"
    },
    "power_move_mult": {
      "type": "number",
      "desc": "Power mode: movement speed multiplier"
    },
    "power_anim_mult": {
      "type": "number",
      "desc": "Power mode: animation (reload, weapon handling) speed multiplier"
    },
    "power_absorb_hit": {
      "type": "bool",
      "desc": "Power mode: the next hit taken is cancelled (then the rank drops)"
    }
  },
